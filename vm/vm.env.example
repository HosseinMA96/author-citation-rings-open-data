# Project F VM, restored from the Project D archive snapshot (never modify the snapshot: it is D's archive).
# Separate resource group from Project E: vmctl.sh refuses any RG other than rg-project-f. Never touch rg-project-e.
# The disk holds C's graph tables (~/c/data/work) and D's work tables (~/d/data/work), both read only for F.
RG=rg-project-f
VM=vm-project-f
LOCATION=eastus
SNAPSHOT_ID=/subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.Compute/snapshots/<snapshot>
SIZE=Standard_E8s_v6                 # 8 vCPU / 64 GB, $0.529/h. Max 8 vCPU: E's VM needs the other 8 of the 20-vCPU quota
DISK_CONTROLLER=NVMe
DISK_GB=256
DISK_SKU=Premium_LRS
ADMIN=azureuser
AUTO_SHUTDOWN_UTC=1500           # backstop only; run_all.sh deallocates the VM when it ends
